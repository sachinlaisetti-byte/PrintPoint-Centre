          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 or 204\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/printers/6",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "printers",
            "6"
          ]
        },
        "description": "CHECK with your teammates whether delete returns 200 or 204."
      },
      "response": []
