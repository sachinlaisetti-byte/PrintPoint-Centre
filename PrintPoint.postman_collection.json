          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/printers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "printers"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Prusa MK4\",\n  \"material\": \"PLA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
